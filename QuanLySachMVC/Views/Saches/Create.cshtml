@model QuanLySachMVC.Models.Sach

@{
    ViewData["Title"] = "Thêm Sách Mới";
}

<div class="card col-md-8 mx-auto shadow-sm">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0">Thêm Sách Mới</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label fw-bold">Tiêu đề sách</label>
                <input asp-for="TieuDe" class="form-control" required />
                <span asp-validation-for="TieuDe" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Tác giả</label>
                    <input asp-for="TacGia" class="form-control" required />
                    <span asp-validation-for="TacGia" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Thể loại</label>
                    <input asp-for="TheLoai" class="form-control" required />
                    <span asp-validation-for="TheLoai" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Giá bán (VNĐ)</label>
                    <input asp-for="GiaBan" type="number" step="1000" class="form-control" required />
                    <span asp-validation-for="GiaBan" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Ngày xuất bản</label>
                    <input asp-for="NgayXuatBan" type="date" class="form-control" required />
                    <span asp-validation-for="NgayXuatBan" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mô tả</label>
                <textarea asp-for="MoTa" rows="3" class="form-control"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                <button type="submit" class="btn btn-success">Lưu Sách</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}